{
  "name": "lumen-loop",
  "private": true,
  "version": "1.0.0",
  "description": "LUMEN LOOP – ein Arcade-Roguelite für das Handy: Zieh Kreise aus Licht.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/gen-icons.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0"
  }
}
