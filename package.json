{
  "name": "lumen-loop",
  "private": true,
  "version": "2.4.0",
  "description": "LUMEN LOOP – Arcade-Roguelite für Android (Capacitor) und das Web: Zieh Kreise aus Licht.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/gen-icons.mjs",
    "smoke": "node scripts/smoke.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:bundle": "npm run android:sync && cd android && ./gradlew bundleRelease"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@types/node": "^22.20.5",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.3.0",
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@capgo/native-purchases": "8.9.10",
    "@fontsource-variable/outfit": "^5.3.0"
  }
}
